# Copy this file to ".env" and fill in the values.

# --- Ojin (the avatar / face) -------------------------------------------------
# Get these from your Ojin account: https://ojin.ai  (docs: https://docs.ojin.ai)
OJIN_API_KEY=
OJIN_CONFIG_ID=

# --- The voice pipeline (STT / LLM / TTS) -------------------------------------
# Speech-to-text — Deepgram. https://console.deepgram.com  (free tier available)
DEEPGRAM_API_KEY=

# LLM — Groq (OpenAI-compatible, runs gpt-oss-120b). https://console.groq.com/keys
GROQ_API_KEY=

# Text-to-speech — ElevenLabs. https://elevenlabs.io
# Needs both the API key and a voice id (pick one in the ElevenLabs voice library).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Optional -----------------------------------------------------------------
# Only needed to join a Daily room: `python bot.py -t daily`. https://dashboard.daily.co
# DAILY_API_KEY=

# Alternative LLM — uncomment the OpenAILLMService line in bot.py to use this instead
# of Groq. https://platform.openai.com/api-keys
# OPENAI_API_KEY=
